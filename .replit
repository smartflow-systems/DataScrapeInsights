modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/index.ts"
waitForPort = 5000

[nix]
packages = ["gh"]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GIT_URL = "https://boweazy:$SFS_PAT@github.com/boweazy/DataScrapeInsights"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
